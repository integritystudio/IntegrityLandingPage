{
  "name": "integrity-studio-sender",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "doppler run --project integrity-studio --config dev -- wrangler deploy --env dev",
    "deploy:prd": "doppler run --project integrity-studio --config prd -- wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "doppler run --project integrity-studio --config dev -- vitest run --config vitest.e2e.config.mts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.6"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
