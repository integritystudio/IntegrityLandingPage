# Sender Worker Environment Template
# Copy to .env.local for local development
# This file is for REFERENCE ONLY — never commit real secrets

# HMAC shared secret (must match receiver-worker secret)
# Generate: openssl rand -base64 32
SHARED_SECRET=test-secret-key-12345

# Receiver Worker URL (development default: localhost:8788)
# Development:  http://localhost:8788
# Staging:      https://receiver-worker-staging.integritystudio.ai
# Production:   https://receiver-worker.integritystudio.ai
RECEIVER_WORKER_URL=http://localhost:8788
