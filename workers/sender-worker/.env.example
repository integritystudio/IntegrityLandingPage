# Sender Worker Environment Template
# Copy to .env.local for local development
# This file is for REFERENCE ONLY — never commit real secrets

# HMAC signing keys (must match the receiver's SIGNING_KEYS exactly).
# Both are required: ACTIVE_KEY_ID is sent as x-key-id and the receiver rejects a request
# without it, so an unset pair means /send returns 500 and forwards nothing.
# Generate a secret: openssl rand -base64 32
SIGNING_KEYS={"v2":"test-secret-key-12345"}
ACTIVE_KEY_ID=v2

# Legacy pre-rotation key. NOT READ — nothing falls back to it (CR29 step 2). Listed only
# because it is still bound in production until that unbinding is cleared.
SHARED_SECRET=test-secret-key-12345

# Receiver Worker URL (development default: localhost:8788)
# Development:  http://localhost:8788
# Staging:      https://receiver-worker-staging.integritystudio.ai
# Production:   https://receiver-worker.integritystudio.ai
RECEIVER_WORKER_URL=http://localhost:8788
