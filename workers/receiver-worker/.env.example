# Receiver Worker Environment Template
# Copy to .env.local for local development
# This file is for REFERENCE ONLY — never commit real secrets

# keyId → secret map. The only credential /inbox authenticates against (CR29 step 2):
# a request whose x-key-id names no entry here is rejected, whatever its signature.
# The entry for the sender's ACTIVE_KEY_ID must match the sender's secret exactly.
# Generate: openssl rand -base64 32
SIGNING_KEYS={"v2":"test-secret-key-12345"}

# Legacy HMAC secret. No longer read for authentication — kept only because production
# still binds it until CR29 step 3. Setting it grants nothing.
SHARED_SECRET=test-secret-key-12345
