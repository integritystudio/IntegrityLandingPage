# Receiver Worker Environment Template
# Copy to .env.local for local development
# This file is for REFERENCE ONLY — never commit real secrets

# HMAC shared secret (must match sender-worker secret exactly)
# Generate: openssl rand -base64 32
# Development:  test-secret-key-12345 (matches sender)
# Staging:      [production-grade secret]
# Production:   [production-grade secret, different from staging]
SHARED_SECRET=test-secret-key-12345
