{
  "name": "integrity-studio-receiver",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "doppler run --project integrity-studio --config dev -- wrangler deploy --env dev",
    "deploy:prd": "doppler run --project integrity-studio --config prd -- wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.55.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
