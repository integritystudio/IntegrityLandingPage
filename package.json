{
  "type": "module",
  "devDependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@types/node": "^25.5.0",
    "repomix": "^1.13.1",
    "stripe": "^21.0.1",
    "supabase": "^2.84.4",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  },
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dedup": "bash scripts/find_duplication.sh",
    "e2e": "npm --prefix e2e test",
    "e2e:headed": "npm --prefix e2e run test:headed",
    "e2e:ui": "npm --prefix e2e run test:ui",
    "report": "npm --prefix e2e run report",
    "repomix": "bash scripts/repomix/repomix-regen.sh",
    "lint": "flutter analyze",
    "lint:workers": "for w in workers/lib workers/contact-form workers/api-gateway workers/sender-worker workers/receiver-worker workers/stripe-webhook; do (cd $w && npx tsc --noEmit) || exit 1; done",
    "test:provisioning": "bash test-provisioning-e2e.sh",
    "test:workers": "for w in workers/lib workers/contact-form workers/api-gateway workers/sender-worker workers/receiver-worker workers/stripe-webhook; do npm --prefix $w test || exit 1; done",
    "check:env-isolation": "bash scripts/check-env-isolation.sh",
    "check:migration-drift": "bash scripts/check-migration-drift.sh",
    "check:worker-signals": "bash scripts/check-worker-signals.sh",
    "check:api-routing": "bash scripts/check-api-routing.sh"
  }
}
