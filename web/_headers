# Cloudflare Pages Headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Note (#30): CSP report endpoints are shared across environments (staging/production).
# Preview deployments use the same Sentry project. Acceptable for landing page use case.
# If environment-specific reporting is needed, use a build script to replace the DSN.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Report-To: {"group":"csp-endpoint","max_age":10886400,"endpoints":[{"url":"https://o4509224386420736.ingest.us.sentry.io/api/4509224390418432/security/?sentry_key=f33ee5bcaaa03614df1bb2b0d0ce88ad"}]}
  Reporting-Endpoints: csp-endpoint="https://o4509224386420736.ingest.us.sentry.io/api/4509224390418432/security/?sentry_key=f33ee5bcaaa03614df1bb2b0d0ce88ad"

# Content.yaml changes frequently - short cache with revalidation
# Must be before /assets/* to avoid header merging
/assets/content.yaml
  Cache-Control: public, max-age=3600, must-revalidate

# Cache other static assets (fonts, images, etc.) for 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/packages/*
  Cache-Control: public, max-age=31536000, immutable

/assets/shaders/*
  Cache-Control: public, max-age=31536000, immutable

/assets/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML (for updates)
/*.html
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
