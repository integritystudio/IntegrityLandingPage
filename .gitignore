.playwright-mcp/

# Wrangler
.wrangler/

# Node.js
node_modules/
package-lock.json
!e2e/package-lock.json

# Claude Code
.claude/

# Repomix output files
repomix-output.xml
docs/repomix/*.xml
*-output.xml

# E2E screenshots
e2e/screenshots/
.ralph-prompt.md

# TypeScript / JavaScript (blanket ignore; Flutter web output generates TS/JS)
*.ts
*.js
*.d.ts
*.js.map
dist/

# Allow functions/ CF Pages middleware source
!functions/**/*.ts
!functions/package.json
!functions/vitest.config.ts

# Allow workers/ CF Workers source
!workers/**/*.ts
!workers/**/package.json
!workers/**/vitest.config.ts

# Allow scripts/ TypeScript source (runbooks, admin utilities)
!scripts/*.ts
