!e2e/package-lock.json

# Claude Code
.claude/

# Repomix output files
repomix-output.xml
docs/repomix/*.xml
*-output.xml

# E2E screenshots
e2e/screenshots/
.ralph-prompt.md

# TypeScript / JavaScript (blanket ignore; Flutter web output generates TS/JS)
*.ts
*.js
*.d.ts
*.js.map
dist/

# Allow functions/ CF Pages middleware source
!functions/**/*.ts
!functions/package.json
!functions/vitest.config.ts

# Allow workers/ CF Workers source
!workers/**/*.ts
!workers/**/package.json
!workers/**/vitest.config.ts

# Allow scripts/ TypeScript source (runbooks, admin utilities)
!scripts/*.ts

# Allow supabase/ Edge Function source
#
# 🔴 Added 2026-08-07. Its absence is why the repo could not rebuild its own
# deployed functions: the blanket `*.ts` above swallowed every
# `supabase/functions/*/index.ts`, so `git ls-files supabase/functions/`
# returned NOTHING while eight functions ran in production. Sources that
# happened to exist locally looked tracked and were not — a fresh clone had
# zero of them. Recovered via `supabase functions download <slug> --project-ref`.
!supabase/functions/**/*.ts

# Serena (machine-specific config, cache, memories)
.serena/
